# Python
__pycache__/
*.pyc
*.pyo
.pytest_cache/

# Environment / secrets
.env
.env.local

# Runtime data (regenerated locally, not source)
data/emotion_lens.db
data/emotion_lens.db-journal
data/recordings/
data/uploads/
data/reports/

# ML artifacts -- large/binary, regenerate via backend/ml/train_emotion_cnn.py
backend/ml/saved_models/*.pt
backend/ml/saved_models/*.pth

# Labelled test footage. RAVDESS is CC BY-NC-SA 4.0: redistributing it from
# this repo would breach the licence, and it is hundreds of MB. The builder
# script is tracked; the media it downloads and produces is not.
data/test_videos/*
!data/test_videos/build_test_video.py
!data/test_videos/evaluate.py
!data/test_videos/download_cremad.py
!data/test_videos/evaluate_cremad.py

# Notas de trabajo propias, no parte del proyecto
notas-locales/

# Editor / OS
.vscode/*
!.vscode/settings.json
.DS_Store
Thumbs.db
