# EmotionLens — production environment template.
# Copy to `.env` in the project root and fill in real values.
# Never commit the real `.env` (already in .gitignore).

APP_NAME=EmotionLens
DEBUG=false

# ── Server ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
CORS_ORIGINS=["https://your-domain.com"]

# ── GPU ──────────────────────────────────────────────────────────
# Set to true only on a VPS/instance with an NVIDIA GPU + CUDA installed.
USE_GPU=false

# ── Database ─────────────────────────────────────────────────────
# PostgreSQL is strongly recommended in production: SQLite does not
# handle the concurrent writes from live WebSocket sessions well.
# Create the DB/role first (see deploy/setup_vps.sh), then set the
# real password here.
DATABASE_URL=postgresql+asyncpg://emotionlens:CHANGE_ME@localhost:5432/emotionlens

# ── Uploads ──────────────────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=500

# ── Auth (login de un solo usuario) ───────────────────────────────
# Genera estos valores con (setup_vps.sh lo hace por ti):
#   ./venv/bin/python -m backend.app.auth crear-credenciales --env .env
# AUTH_ENABLED=false solo en desarrollo local, nunca en el servidor.
AUTH_ENABLED=true
AUTH_USERNAME=
AUTH_PASSWORD_HASH=
AUTH_SECRET_KEY=
AUTH_SESSION_HOURS=12
