# EmotionLens — Nginx reverse proxy config.
# Copy to /etc/nginx/sites-available/emotionlens, replace your-domain.com,
# symlink into sites-enabled, then run `certbot --nginx -d your-domain.com`
# to add HTTPS automatically (certbot rewrites this file in place).

server {
    listen 80;
    server_name your-domain.com;

    client_max_body_size 500M;  # allow video uploads

    location / {
        proxy_pass http://127.0.0.1:8000;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # WebSocket (live emotion analysis)
    location /ws/ {
        proxy_pass http://127.0.0.1:8000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection "upgrade";
        proxy_set_header Host $host;
        proxy_read_timeout 86400;
    }
}
